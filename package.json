{
  "name": "svelte-intercom",
  "type": "module",
  "version": "0.0.35",
  "packageManager": "pnpm@9.9.0",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": {
    "name": "John Paul Calvo",
    "email": "calvojp92@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calvo-jp/svelte-intercom.git"
  },
  "bugs": {
    "url": "https://github.com/calvo-jp/svelte-intercom/issues",
    "email": "calvojp92@gmail.com"
  },
  "description": "Intercom for Svelte",
  "keywords": [
    "Intercom",
    "Svelte Intercom"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "release": "release-it"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "dependencies": {
    "@intercom/messenger-js-sdk": "^0.0.14"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.7.2",
    "@sveltejs/package": "^2.3.5",
    "@sveltejs/vite-plugin-svelte": "4.0.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/svelte": "^5.2.4",
    "@testing-library/user-event": "^14.5.2",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.7",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "publint": "^0.2.11",
    "release-it": "^17.10.0",
    "svelte": "^5.0.3",
    "svelte-check": "^4.0.5",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${npm.name} v${version}",
      "tagName": "${npm.name}@${version}"
    },
    "github": {
      "release": false
    },
    "hooks": {
      "before:init": [
        "pnpm check",
        "pnpm test"
      ],
      "after:bump": [
        "pnpm build"
      ]
    }
  }
}
